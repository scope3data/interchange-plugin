    },
    {
      "route": "scripts/inspect-tag-sheet.mjs",
      "file": "scripts/inspect-tag-sheet.mjs",
      "contentType": "text/javascript; charset=utf-8"
    },
    {
      "route": "references/parser-profile.json",
      "file": "references/parser-profile.json",
      "contentType": "application/json; charset=utf-8"
    },
    {
      "route": "references/receipt.schema.json",
      "file": "references/receipt.schema.json",
      "contentType": "application/json; charset=utf-8"
